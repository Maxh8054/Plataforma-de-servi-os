generator client {
  provider      = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String                  @id @default(cuid())
  email         String                  @unique
  name          String?
  password      String?
  role          String                  @default("user")
  department    String?
  isActive      Boolean                 @default(true) @map("isActive")
  isFirstAccess Boolean                 @default(true) @map("isFirstAccess")
  loginAttempts Int                     @default(0)
  lockedUntil   DateTime?
  sessionToken  String?                 @unique
  tokenExpiresAt DateTime?
  lastSeenAt    DateTime?               @map("lastSeenAt")
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  auditLogs         AuditLog[]
  passwordResetRequests PasswordResetRequest[]
  twoFactorChallenges   TwoFactorChallenge[]
  reportHistories   ReportHistory[]
  sharedSessions    SharedSession[]
  reportDrafts      ReportDraft[]
}

model TwoFactorChallenge {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("two_factor_challenges")
}

model PasswordResetRequest {
  id                   String    @id @default(cuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id])
  status               String    @default("pending")
  newGeneratedPassword String
  desiredPassword      String?
  createdAt            DateTime  @default(now())
  resolvedAt           DateTime?
  resolvedBy           String?

  @@map("password_reset_requests")
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  userId    String?
  userEmail String?
  userName  String?
  ip        String?
  details   String?
  severity  String   @default("info")
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([severity])
  @@map("audit_logs")
}

model Request {
  id        String   @id @default(cuid())
  type      String
  email     String
  data      String
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EscalaData {
  id    Int    @id @default(1)
  dados String // JSON string

  @@map("escala_data")
}

model Equipment {
  id                    String   @id @default(cuid())
  equipamento           String
  modelo                String
  cliente               String
  size                  String
  local                 String
  empresa               String
  ano                   String
  statusOperacao        String?  @map("status_operacao")
  motivoStandby         String?  @map("motivo_standby")
  falhasCriticas        String?  @map("falhas_criticas")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("equipment")
}

// ==========================================
// ZAB-Flow Models (GestorZA Integration)
// ==========================================

model ZabUsuario {
  id          Int    @id @default(autoincrement())
  nome        String @unique
  email       String @unique
  senha       String
  nivel       String @default("Junior")   // Junior/Pleno/Senior/Administrador/Coordenador/Gerente
  pontos      Int    @default(0)
  conquistas  String @default("[]")       // JSON array: ["star","fire","gold","silver","crown"]
  role        String @default("funcionario") // funcionario or gestor
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("zab_usuarios")
}

model ZabDemanda {
  id                                Int     @id @default(autoincrement())
  funcionarioId                     Int
  nomeFuncionario                   String
  emailFuncionario                  String
  categoria                         String
  prioridade                        String   // Importante/Média/Relevante
  complexidade                      String   // Fácil/Médio/Difícil
  descricao                         String
  local                             String   // Lundin/R&D/U&M
  dataCriacao                       String   @default("CURRENT_TIMESTAMP")
  dataLimite                        String
  status                            String   @default("pendente")
  isRotina                          Int      @default(0) // 0 or 1 boolean
  diasSemana                        String?  // JSON array of day indices [0-6]
  tag                               String?  // Auto-generated: "ZAB-XX"
  comentarios                       String?  @default("")
  comentarioGestor                  String?  @default("")
  dataConclusao                     String?
  atribuidos                        String   @default("[]")  // JSON array of {id, nome, email}
  anexosCriacao                     String   @default("[]")  // JSON array of base64 attachments
  anexosResolucao                   String   @default("[]")  // JSON array of base64 attachments
  comentarioReprovacaoAtribuicao    String?  @default("")
  nomeDemanda                       String?
  dataAtualizacao                   String?  @default("CURRENT_TIMESTAMP")
  criadoPor                         Int?
  atualizadoPor                     Int?
  comentariosUsuarios               String   @default("[]")  // JSON array of user comments
  createdAt                         DateTime @default(now())
  updatedAt                         DateTime @updatedAt

  @@index([status])
  @@index([funcionarioId])
  @@index([dataLimite])
  @@index([categoria])
  @@index([prioridade])
  @@map("zab_demandas")
}

model ZabAudit {
  id          Int     @id @default(autoincrement())
  acao        String  // CREATE/UPDATE/DELETE/EXTEND_DEADLINE/REASSIGN
  tabela      String
  registroId  Int
  dadosAntigos String?
  dadosNovos   String?
  usuarioId   Int?
  dataHora    String  @default("CURRENT_TIMESTAMP")
  ip          String?
  createdAt   DateTime @default(now())

  @@map("zab_audit")
}

model ZabFeedback {
  id            Int     @id @default(autoincrement())
  funcionarioId Int
  gestorId      Int     @default(99)
  tipo          String
  mensagem      String
  dataCriacao   String  @default("CURRENT_TIMESTAMP")
  createdAt     DateTime @default(now())

  @@map("zab_feedbacks")
}

model ZabNote {
  id          Int     @id @default(autoincrement())
  titulo      String
  conteudo    String
  cor         String  @default("#3498db")  // Blue/Green/Red/Yellow/Purple
  dataCriacao String  @default("CURRENT_TIMESTAMP")
  criadoPor   Int
  atribuidoA  Int?
  audioData   String?  // Base64 audio transcription
  atualizadoEm String? @default("CURRENT_TIMESTAMP")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("zab_notes")
}

model ZabNotification {
  id          Int     @id @default(autoincrement())
  usuarioId   Int     // Who receives the notification
  titulo      String
  mensagem    String
  tipo        String  @default("info") // info, warning, danger, success, atribuicao, aprovacao, reprovacao, cobranca
  lida        Int     @default(0) // 0 = unread, 1 = read
  demandaId   Int?
  criadoEm    String  @default("CURRENT_TIMESTAMP")
  createdAt   DateTime @default(now())

  @@index([usuarioId])
  @@index([lida])
  @@map("zab_notifications")
}

// ==========================================
// Estoque Goiás
// ==========================================

model EstoqueGoias {
  id         Int    @id @default(1)
  pecas      String @default("{}")      // JSON: { "PN": { pn, nome, qtd, ... } }
  retiradas  String @default("[]")      // JSON array
  pesquisas  String @default("[]")      // JSON array
  logins     String @default("[]")      // JSON array

  @@map("estoque_goias")
}

// ==========================================
// Inspeções de Segurança (app /html/inspecoes-seguranca.html)
// Público: qualquer usuário autenticado lê e cria; editar/excluir exige autor ou admin
// ==========================================

model Inspection {
  id                   Int      @id @default(autoincrement())
  areaName             String   @map("areaName")
  inspectionDate       String   @map("inspectionDate")
  deadlineDate         String   @map("deadlineDate")
  location             String?
  riskLevel            String   @default("low") @map("riskLevel") // low | medium | high
  observations         String?
  status               String   @default("pending") // pending | in-progress | completed
  completionPercentage Int      @default(0) @map("completionPercentage")
  checklistData        Json?    @map("checklistData")
  photos               Json?    // [{ src, description, riskLevel, resolved, resolutionText, ... }]
  areaPhoto            String?  @map("areaPhoto")
  authorId             String?  @map("authorId")
  authorName           String?  @map("authorName")
  authorEmail          String?  @map("authorEmail")
  createdAt            DateTime @default(now()) @map("createdAt")
  updatedAt            DateTime @updatedAt @map("updatedAt")

  @@index([createdAt])
  @@map("inspections")
}

// ==========================================
// Auditorias de EPIs (app /html/auditoria-epis.html)
// ==========================================

model EpiAudit {
  id          Int      @id @default(autoincrement())
  data        String   // data da auditoria (string yyyy-mm-dd do formulário)
  responsavel String
  funcao      String?
  colaborador String   @map("colaborador")
  area        String
  observacoes String?
  epis        Json?    // [{ tipo, nomes, condicao, substituicao, higienizado }]
  authorId    String?  @map("authorId")
  authorName  String?  @map("authorName")
  authorEmail String?  @map("authorEmail")
  createdAt   DateTime @default(now()) @map("createdAt")
  updatedAt   DateTime @updatedAt @map("updatedAt")

  @@index([createdAt])
  @@map("epi_audits")
}

// ==========================================
// Z-Services AI — Criar Relatórios (app /relatorios)
// Autenticação própria (NextAuth JWT) reutilizando a tabela User;
// histórico e sessões de colaboração agora no PostgreSQL da plataforma
// (antes: SQLite efêmero no Render, perdido a cada deploy)
// ==========================================

model ReportHistory {
  id          String   @id @default(cuid())
  userId      String
  userName    String
  reportType  String
  tag         String
  cliente     String?
  descricao   String?
  conclusao   String?
  executantes String?
  machineDown Boolean  @default(false) @map("machineDown")
  data        String   // JSON do relatório (string)
  finalizedAt DateTime @default(now()) @map("finalizedAt")
  createdAt   DateTime @default(now()) @map("createdAt")
  updatedAt   DateTime @updatedAt @map("updatedAt")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("report_histories")
}

model SharedSession {
  id             String   @id @default(cuid())
  sessionId      String   @unique @map("sessionId")
  creatorId      String
  creatorName    String
  reportType     String
  permission     String
  data           String   // JSON da sessão compartilhada (string)
  expiresAt      DateTime @map("expiresAt")
  savedToHistory Boolean  @default(false) @map("savedToHistory")
  historyId      String?  @map("historyId")
  createdAt      DateTime @default(now()) @map("createdAt")
  updatedAt      DateTime @updatedAt @map("updatedAt")
  creator        User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([creatorId])
  @@map("shared_sessions")
}

// Rascunho automático do Criar Relatórios: um por usuário e por tipo de
// relatório ('home' | 'inspecao'). Salvo continuamente no servidor para que
// a pessoa nunca perca o que estava digitando — recarregou, fechou a aba,
// trocou de computador no dia seguinte: o rascunho volta do banco.
model ReportDraft {
  id         String   @id @default(cuid())
  userId     String
  reportType String
  data       String   // JSON snapshot do relatório (campos + fotos base64)
  createdAt  DateTime @default(now()) @map("createdAt")
  updatedAt  DateTime @updatedAt @map("updatedAt")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, reportType])
  @@map("report_drafts")
}

// ==========================================
// Painel TV ZAMine (ex.: painel de Goiás)
// Conteúdo por aba com fluxo de aprovação:
//  - admin salva direto no ar (data)
//  - editor com permissão salva em pendingData e o admin aprova para ir à TV
// ==========================================

// Conteúdo vivo + pendente de cada aba do painel (seguranca, dds, comunicados, ...)
model TvSection {
  id                String    @id @default(cuid())
  panelSlug         String    @map("panelSlug") // "goias"
  sectionKey        String    @map("sectionKey")
  data              String    @default("{}") // JSON no ar (aprovado) — é o que a TV mostra
  atualizadoEm      DateTime? @map("atualizadoEm")
  atualizadoPorId   String?   @map("atualizadoPorId")
  atualizadoPorNome String?   @map("atualizadoPorNome")
  pendingData       String?   @map("pendingData") // JSON aguardando aprovação do admin
  pendingEm         DateTime? @map("pendingEm")
  pendingPorId      String?   @map("pendingPorId")
  pendingPorNome    String?   @map("pendingPorNome")
  createdAt         DateTime  @default(now()) @map("createdAt")
  updatedAt         DateTime  @updatedAt @map("updatedAt")

  @@unique([panelSlug, sectionKey])
  @@map("tv_sections")
}

// Configurações do painel (rotação, tempos, letreiro, cores) — somente admin
model TvPanelConfig {
  id                String    @id @default(cuid())
  panelSlug         String    @unique @map("panelSlug")
  data              String    @default("{}")
  atualizadoEm      DateTime? @map("atualizadoEm")
  atualizadoPorId   String?   @map("atualizadoPorId")
  atualizadoPorNome String?   @map("atualizadoPorNome")
  createdAt         DateTime  @default(now()) @map("createdAt")
  updatedAt         DateTime  @updatedAt @map("updatedAt")

  @@map("tv_panel_configs")
}

// Permissão de edição por aba: admin escolhe qual usuário edita qual aba
model TvPermissao {
  id           String   @id @default(cuid())
  panelSlug    String   @map("panelSlug")
  userEmail    String   @map("userEmail")
  userName     String?  @map("userName")
  sectionKey   String   @map("sectionKey")
  concedidoPor String?  @map("concedidoPor") // email do admin que concedeu
  createdAt    DateTime @default(now()) @map("createdAt")

  @@unique([panelSlug, userEmail, sectionKey])
  @@map("tv_permissoes")
}

// Controle em tempo real do painel TV: uma pessoa por vez assume o comando do que a TV
// mostra (pausar, avançar, voltar, escolher tela) — ex.: conduzir o DDS com o slide parado.
// Quem tem permissão de editar alguma aba pode assumir; o controle é EXCLUSIVO e outras
// pessoas recebem "em uso por ...". Admin pode assumir por cima ou encerrar e voltar ao
// normal. Sem heartbeat (PC dormiu/fechou), o lock expira e a TV volta à rotação sozinha.
model TvControl {
  id        String    @id @default(cuid())
  panelSlug String    @unique @map("panelSlug")
  donoEmail String?   @map("donoEmail")
  donoNome  String?   @map("donoNome")
  donoAdmin Boolean   @default(false) @map("donoAdmin")
  pausado   Boolean   @default(true)
  slide     String    @default("") // tela no ar (key ou key#sub); vazia = mantém a atual
  rev       Int       @default(0)  // incrementa a cada mudança — TVs sabem quando aplicar
  beatAt    DateTime? @map("beatAt") // heartbeat de quem controla (lock expira sem ele)
  ultimaAcaoAt DateTime? @map("ultimaAcaoAt") // última ação real (acquire/goto): expira o controle após 8 min sem usar
  desde     DateTime? @map("desde") // quando o controle foi assumido
  updatedAt DateTime  @updatedAt @map("updatedAt")

  @@map("tv_controls")
}

// Contador oficial de "dias sem afastamento" por regional — data-base editável
// pelo admin na plataforma (substitui a data fixa em src/lib/contador-seguranca.ts,
// que continua como fallback/seed). Assim o contador sobrevive a qualquer deploy:
// quem atualiza é o admin na tela inicial, sem precisar de commit novo.
model ContadorSeguranca {
  regional          String   @id // "goias", "minas", ...
  dataBase          String // YYYY-MM-DD — dia do último acidente com afastamento
  atualizadoEm      DateTime @default(now()) @updatedAt @map("atualizadoEm")
  atualizadoPorId   String?  @map("atualizadoPorId")
  atualizadoPorNome String?  @map("atualizadoPorNome")
  createdAt         DateTime @default(now()) @map("createdAt")

  @@map("contador_seguranca")
}

// Entrega do RELATÓRIO TÉCNICO por técnico e por dia da escala de turno.
// O responsável marca na plataforma (Escala de Turno → Status em Tempo Real),
// individualmente para cada técnico (letras A–D), se o relatório do dia foi
// entregue ou não. A TV mostra o status no slide da escala (ontem/hoje).
// Tudo no banco: sobrevive a deploy/commit novo.
model RelatorioTecnico {
  id            Int      @id @default(autoincrement())
  data          String // YYYY-MM-DD — dia da escala a que o relatório se refere
  letra         String // A | B | C | D (técnico da escala)
  entregue      Boolean  @default(false)
  atualizadoEm  DateTime @default(now()) @updatedAt @map("atualizadoEm")
  atualizadoPor String?  @map("atualizadoPor")
  createdAt     DateTime @default(now()) @map("createdAt")

  @@unique([data, letra])
  @@map("relatorio_tecnico")
}

// Imagens do painel (fotos de DDS, comunicados, campanhas, aniversariantes, organograma)
model TvAsset {
  id          String   @id @default(cuid())
  mime        String
  size        Int
  bytes       Bytes
  uploadedPor String?  @map("uploadedPor")
  createdAt   DateTime @default(now()) @map("createdAt")

  @@map("tv_assets")
}

// ==========================================
// Saúde das TVs (heartbeat): cada aparelho se anuncia a cada poucos
// minutos (canal atual, nº de telas no ar). O editor e o dashboard
// "TVs conectadas" mostram 🟢 online / 🔴 offline por aparelho.
// ==========================================

model TvDispositivo {
  id        String   @id @default(cuid())
  panelSlug String   @map("panelSlug") // painel (goias, minas-araxa…)
  deviceId  String   @map("deviceId") // código salvo no aparelho (ex.: TV-4F2A)
  canal     String? // nome do canal em uso ("" = Tudo)
  telas     Int? // quantas telas estão na rotação agora
  ua        String? // user-agent (identifica smart TV / navegador)
  ultimaVez DateTime @default(now()) @map("ultimaVez")
  criadoEm  DateTime @default(now()) @map("criadoEm")

  @@unique([panelSlug, deviceId])
  @@map("tv_dispositivos")
}

// ==========================================
// Backup automático agendado do painel TV (+ cópia pré-edição).
// Um snapshot por dia (criado na primeira leitura do dia) e uma cópia
// do conteúdo ANTES de cada salvar — restauração com 1 clique.
// ==========================================

model TvBackup {
  id        String   @id @default(cuid())
  panelSlug String   @map("panelSlug")
  origem    String   @default("auto") // auto | pre-edicao | manual
  dados     String // JSON pack { secoes, config }
  criadoEm  DateTime @default(now()) @map("criadoEm")

  @@index([panelSlug, criadoEm])
  @@map("tv_backups")
}

// ==========================================
// Central de notificações (sino na plataforma): guarda só quando cada
// usuário viu as notificações pela última vez; os itens são calculados
// na hora (TV offline, backup concluído, conteúdo expirando…).
// ==========================================

model NotificacaoLeitura {
  userEmail String   @id @map("userEmail")
  ultimaVez DateTime @default(now()) @updatedAt @map("ultimaVez")

  @@map("notificacoes_leitura")
}

// ==========================================
// Sino: itens dispensados individualmente (o X em cada notificação).
// itemKey muda quando a OCORRÊNCIA é nova (nova queda da TV, nova pendência,
// novo backup), então dispensar não esconde problemas futuros — só o aviso atual.
// Tabela também criada por CREATE TABLE IF NOT EXISTS em src/lib/tv-monitor.ts.
// ==========================================

model NotificacaoDispensa {
  id        String   @id @default(cuid())
  userEmail String   @map("userEmail")
  itemKey   String   @map("itemKey")
  criadoEm  DateTime @default(now()) @map("criadoEm")

  @@unique([userEmail, itemKey])
  @@map("notificacoes_dispensas")
}

// ==========================================
// [OBSOLETO] Organograma da plataforma via modal no rodapé — desativado.
// O organograma agora vive no PAINEL TV (aba Organograma → TvSection
// "organograma"), com as fotos casadas PELO NOME no cadastro de
// Aniversariantes. Modelo mantido só para preservar a tabela existente.
// ==========================================

model OrganogramaData {
  id            Int       @id @default(1)
  dados         String    // JSON: [{ id, nome, cargo, posicao, fileira, ligacao, vaga }]
  atualizadoEm  DateTime? @map("atualizadoEm")
  atualizadoPor String?   @map("atualizadoPor")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("organograma_data")
}

// ==========================================
// Programação Semanal (Manutenção) — semanas criadas pela gestão
// (ex.: "semana 1") com as paradas das máquinas EH-01/02/03, duração,
// motivo e os backlogs programados com as aplicações realizadas
// (feito + hora). Tudo vai para o banco; nada fica no navegador.
// ==========================================

model ProgramacaoSemanal {
  id                 String   @id @default(cuid())
  panelSlug          String   @map("panelSlug") // painel dono (goias, minas…)
  ano                Int      // ano da semana ISO
  semana             Int      // nº da semana ISO (1–53), escolhido pelo usuário
  dados              String // JSON: { machines: { EH-01: { dia, horas, motivo, backlogs, done[], feitoEm{} } } }
  atualizadoPorNome  String?  @map("atualizadoPorNome")
  atualizadoPorEmail String?  @map("atualizadoPorEmail")
  createdAt          DateTime @default(now()) @map("createdAt")
  updatedAt          DateTime @updatedAt @map("updatedAt")

  @@unique([panelSlug, ano, semana])
  @@map("programacao_semanal")
}
